# This app has no database of its own — every read/write goes straight to the
# CRM's own API, same pattern as the Ev Landing dealer-onboarding dashboard.
# Uses the SAME dealer_session cookie: a dealer who signed in via Ev Landing
# (or here) is recognized on both, since the cookie belongs to the API's
# origin, not either frontend's.

# The browser calls this directly (src/lib/crm/dealerAuth.ts) — must be
# reachable from the dealer's browser, not just from this server.
NEXT_PUBLIC_CRM_API_URL=http://localhost:4000
